    "controller.animation.m870.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": [
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "checker": "query.get_equipped_item_name=='m870_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "checker": "(query.get_equipped_item_name=='m870' && variable.attack_time > 0.0f && query.scoreboard('m870') <= 5 && q.mark_variant != 3)"
            }
          ]
        },
        "checker": {
          "on_entry": [
            "/event entity @s[hasitem={item=tac_guns:12gauge}] tac_guns:shotgunreload"
          ],
          "transitions": [
            {
              "reload": "q.mark_variant == 5 && query.get_equipped_item_name=='m870_emp'"
            },
            {
              "reloadtac": "q.mark_variant == 5 && query.get_equipped_item_name=='m870'"
            },
            {
              "setup": "(query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp') && q.mark_variant == 0"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "m870reload": "q.mark_variant == 5"
            }
          ],
          "on_entry": [
            "v.time = q.life_time;",
            "/event entity @s[hasitem={item=tac_guns:12gauge}] tac_guns:shotgunreload"
          ],
          "transitions": [
            {
              "reloadtac": "query.get_equipped_item_name!='m870_emp'"
            },
            {
              "holder": "query.any_animation_finished"
            },
            {
              "holder2": "query.scoreboard('m870') >= 6"
            },
            {
              "holder2": "q.is_using_item && (q.life_time - v.time) >= 0.1"
            }
          ]
        },
        "holder": {
          "on_entry": [
            "v.time = q.life_time;",
            "/event entity @s[hasitem={item=tac_guns:12gauge}] tac_guns:shotgunreload"
          ],
          "transitions": [
            {
              "reload": "q.mark_variant == 5 && query.get_equipped_item_name=='m870_emp'"
            },
            {
              "reloadtac": "q.mark_variant == 5 && query.get_equipped_item_name=='m870'"
            },
            {
              "holder2": "(query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp') && q.mark_variant == 0"
            },
            {
              "holder2": "q.is_using_item && (q.life_time - v.time) >= 0.1"
            }
          ]
        },
        "reloadtac": {
          "animations": [
            {
              "m870reload": "q.mark_variant == 5"
            }
          ],
          "on_entry": [
            "v.time = q.life_time;",
            "/event entity @s[hasitem={item=tac_guns:12gauge}] tac_guns:shotgunreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='m870'"
            },
            {
              "holder": "query.any_animation_finished"
            },
            {
              "holder2": "query.scoreboard('m870') >= 6"
            },
            {
              "holder2": "q.is_using_item && (q.life_time - v.time) >= 0.1"
            }
          ]
        },
        "holder2": {
          "on_entry":[
            "v.time = q.life_time;",
            "@s tac_guns:shotgunreloadfinish"
          ],
          "transitions": [
            {
              "reloadfinish": "query.all_animations_finished && (q.life_time - v.time) >= 1.5"
            }
          ]
        },
        "reloadfinish": {
          "on_entry": [
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp'"
            }
          ]
        }
      }
    },
