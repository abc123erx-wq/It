{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.coltpython.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": [
            "@s tac_guns:noreload",
            "/stopsound @s coltpython.reload",
            "/stopsound @s coltpython.tacreload"
          ],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='coltpython_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='coltpython' && variable.attack_time > 0.0f && query.scoreboard('coltpython') <= 5 && q.mark_variant != 3)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": [
            "/function coltpythonquantity",
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='coltpython' && q.property('tac_guns:coltpythonreload') == 0"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='coltpython' && q.property('tac_guns:coltpythonreload') >= 1"
            },
            {
              "setup": "query.get_equipped_item_name!='coltpython'"
            }
          ]
        },
        "trigger.reload": {
          "on_entry": [
            "/function coltpythonquantity",
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='coltpython_emp' && q.property('tac_guns:coltpythonreload') == 0"
            },
            {
              "reload": "query.get_equipped_item_name=='coltpython_emp' && q.property('tac_guns:coltpythonreload') >= 1"
            },
            {
              "setup": "query.get_equipped_item_name!='coltpython'"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "coltpythonreload": "query.get_equipped_item_name('main_hand')=='coltpython_emp' || query.get_equipped_item_name('main_hand')=='coltpython'"
            }
          ],
          "on_entry": [
            "@s tac_guns:reload",
            "/playsound coltpython.reload @s"
          ],
          "on_exit": [
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='coltpython_emp'"
            },
            {
              "reloadfinish": "query.all_animations_finished"
            }
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "coltpythonreloadtac": "query.get_equipped_item_name('main_hand')=='coltpython_emp' || query.get_equipped_item_name('main_hand')=='coltpython'"
            }
          ],
          "on_entry": [
            "@s tac_guns:reloadtac",
            "/playsound coltpython.reload @s"
          ],
          "on_exit": [
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='coltpython'"
            },
            {
              "reloadfinish": "query.all_animations_finished"
            }
          ]
        },
        "reloadfinish": {
          "on_exit": [
            "@s tac_guns:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='coltpython' || query.get_equipped_item_name=='coltpython_emp'"
            }
          ]
        }
      }
    },
