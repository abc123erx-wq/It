{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dp28": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='dp28' && q.is_using_item) || query.get_equipped_item_name=='dp28_emp'"
            }
          ],
          "on_entry": [
            "@s[hasitem={item=tac_guns:dp28, location=slot.weapon.mainhand}] tac_guns:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "dp28.30": "query.get_equipped_item_name=='dp28' && query.is_using_item && query.scoreboard('dp28') >= 1 && q.mark_variant == 0"
            }
          ]
        },
        "dp28.30": {
          "animations": [
            "dp28shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s tac_guns:dp28_fire",
            "@s tac_guns:bulletbait",
            "/scoreboard players remove @s[scores={dp28=1..50}] dp28 1",
            "/playsound dp28.shoot @a ~~~",
            "/replaceitem entity @s[scores={dp28=0}] slot.weapon.mainhand 1 tac_guns:dp28_emp 1 0"
          ]
        }
      }
    }
  }
}