{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m870": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m870' && q.is_using_item) || query.get_equipped_item_name=='m870_emp'"
            }
          ],
          "on_entry": [
            "@s[hasitem={item=tac_guns:m870, location=slot.weapon.mainhand}] tac_guns:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m870.30": "query.get_equipped_item_name=='m870' && query.is_using_item && query.scoreboard('m870') >= 1 && q.mark_variant == 0"
            }
          ]
        },
        "m870.30": {
          "animations": [
            "m870shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished && !q.is_using_item"
            }
          ],
          "on_entry": [
            "@s tac_guns:m870_fire",
            "/scoreboard players remove @s[scores={m870=1..8}] m870 1",
            "/playsound m870.shoot @a ~~~",
            "/replaceitem entity @s[scores={m870=0}] slot.weapon.mainhand 1 tac_guns:m870_emp 1 0"
          ]
        }
      }
    }
  }
}