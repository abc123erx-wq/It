            "@s[hasitem={item=tac_guns:m134, location=slot.weapon.mainhand}] tac_guns:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m134.30": "(query.get_equipped_item_name=='m134' && query.is_using_item && query.scoreboard('m134') >= 1)"
            }
          ]
        },
        "m134.30": {
          "animations": [
            "m134shoot"
          ],
          "transitions": [
            {
              "m134.29": "query.get_equipped_item_name=='m134' && query.all_animations_finished && q.is_using_item"
            },
            {
              "setup": "query.get_equipped_item_name!='m134' || !q.is_using_item"
            }
          ],
