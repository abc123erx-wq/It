{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.db": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='db' && q.is_using_item) || query.get_equipped_item_name=='db_emp'"
            }
          ],
          "on_entry": [
            "@s[hasitem={item=tac_guns:db, location=slot.weapon.mainhand}] tac_guns:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "db.30": "query.get_equipped_item_name=='db' && query.is_using_item && query.scoreboard('db') >= 1 && q.mark_variant == 0"
            }
          ]
        },
        "db.30": {
          "animations": [
            "dbshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished && !q.is_using_item"
            }
          ],
          "on_entry": [
            "@s tac_guns:db_fire",
            "/scoreboard players remove @s[scores={db=1..2}] db 1",
            "/playsound db.shoot @a ~~~",
            "/replaceitem entity @s[scores={db=0}] slot.weapon.mainhand 1 tac_guns:db_emp 1 0"
          ]
        }
      }
    }
  }
}