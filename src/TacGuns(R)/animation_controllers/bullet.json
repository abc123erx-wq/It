{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.bullet": {
      "initial_state": "start",
      "states": {
        "start": {
          "animations": [
            "bullet_start"
          ],
          "transitions": [
            {
              "finish": "query.all_animations_finished"
            }
          ]
        },
        "finish": {
          "animations": [
            "bullet_finish"
          ]
        }
      }
    }
  }
}