    "controller.render.workbench_ui": {
      "geometry": "Geometry.workbench_ui",
      "materials": [
        {
          "*": "Material.glow"
        }
      ],
      "textures": [
        "Texture.workbench_ui"
      ],
      "is_hurt_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "on_fire_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "part_visibility": [
        {
          "*": true
        },
        {
          "forward": "q.variant == 1"
        },
        {
          "back": "q.variant == 2"
