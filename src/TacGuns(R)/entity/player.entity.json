      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "variable.is_holding_right = 0.0;",
          "variable.is_blinking = 0.0;",
          "variable.last_blink_time = 0.0;",
          "variable.hand_bob = 0.0;"
        ],
        "pre_animation": [
          "variable.is_third_person = !variable.is_first_person && !variable.map_face_icon;",
          "variable.helmet_layer_visible = 1.0;",
          "variable.leg_layer_visible = 1.0;",
          "variable.boot_layer_visible = 1.0;",
          "variable.chest_layer_visible = 1.0;",
          "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
          "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive && !variable.holding_all_guns ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
          "variable.holding_all_guns = query.get_equipped_item_name=='dp28' || query.get_equipped_item_name=='dp28_emp' || query.get_equipped_item_name=='db' || query.get_equipped_item_name=='db_emp' || query.get_equipped_item_name=='glock17' || query.get_equipped_item_name=='glock17_emp' || query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp' || query.get_equipped_item_name=='deagle' || query.get_equipped_item_name=='deagle_emp' || query.get_equipped_item_name=='m134' || query.get_equipped_item_name=='ak47' || query.get_equipped_item_name=='ak47_emp' || query.get_equipped_item_name=='coltpython' || query.get_equipped_item_name=='coltpython_emp' || query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp' || query.get_equipped_item_name=='mk18' || query.get_equipped_item_name=='mk18_emp';",
          "variable.m134 = query.get_equipped_item_name=='m134';",
          "variable.mk18 = query.get_equipped_item_name=='mk18' || query.get_equipped_item_name=='mk18_emp';",
          "variable.mk18b = query.get_equipped_item_name=='mk18';",
          "variable.mk18emp = query.get_equipped_item_name=='mk18_emp';",
          "variable.coltpython = query.get_equipped_item_name=='coltpython' || query.get_equipped_item_name=='coltpython_emp';",
          "variable.coltpythonb = query.get_equipped_item_name=='coltpython';",
          "variable.coltpythonemp = query.get_equipped_item_name=='coltpython_emp';",
          "variable.deagle = query.get_equipped_item_name=='deagle' || query.get_equipped_item_name=='deagle_emp';",
          "variable.deagleb = query.get_equipped_item_name=='deagle';",
          "variable.deagleemp = query.get_equipped_item_name=='deagle_emp';",
          "variable.db = query.get_equipped_item_name=='db' || query.get_equipped_item_name=='db_emp';",
          "variable.dbb = query.get_equipped_item_name=='db';",
          "variable.dbemp = query.get_equipped_item_name=='db_emp';",
          "variable.glock17 = query.get_equipped_item_name=='glock17' || query.get_equipped_item_name=='glock17_emp';",
          "variable.glock17b = query.get_equipped_item_name=='glock17';",
          "variable.glock17emp = query.get_equipped_item_name=='glock17_emp';",
          "variable.m870 = query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp';",
          "variable.m870b = query.get_equipped_item_name=='m870';",
          "variable.m870emp = query.get_equipped_item_name=='m870_emp';",
          "variable.ak47 = query.get_equipped_item_name=='ak47' || query.get_equipped_item_name=='ak47_emp';",
          "variable.ak47b = query.get_equipped_item_name=='ak47';",
          "variable.ak47emp = query.get_equipped_item_name=='ak47_emp';",
          "variable.dp28 = query.get_equipped_item_name=='dp28' || query.get_equipped_item_name=='dp28_emp';",
          "variable.dp28b = query.get_equipped_item_name=='dp28';",
          "variable.dp28emp = query.get_equipped_item_name=='dp28_emp';",
          "variable.awp = query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp';",
          "variable.awpb = query.get_equipped_item_name=='awp';",
          "variable.awpemp = query.get_equipped_item_name=='awp_emp';",
          "variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
          "variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;"
