{"\u0068\u0075\u0064\u005f\u0061\u0063\u0074\u0069\u006f\u006e\u0062\u0061\u0072\u005f\u0074\u0065\u0078\u0074":{"\u0074\u0079\u0070\u0065":"\u0069\u006d\u0061\u0067\u0065","\u0073\u0069\u007a\u0065":["\u0031\u0030\u0030\u0025\u0063\u0020\u002b\u0020\u0031\u0032\u0070\u0078","\u0031\u0030\u0030\u0025\u0063\u0020\u002b\u0020\u0035\u0070\u0078"],"\u006f\u0066\u0066\u0073\u0065\u0074":[0,"\u0035\u0030\u0025\u002d\u0036\u0038\u0070\u0078"],"\u0074\u0065\u0078\u0074\u0075\u0072\u0065":"\u0074\u0065\u0078\u0074\u0075\u0072\u0065\u0073\u002f\u0075\u0069\u002f\u0068\u0075\u0064\u005f\u0074\u0069\u0070\u005f\u0074\u0065\u0078\u0074\u005f\u0062\u0061\u0063\u006b\u0067\u0072\u006f\u0075\u006e\u0064","\u0061\u006c\u0070\u0068\u0061":"\u0040\u0068\u0075\u0064\u002e\u0061\u006e\u0069\u006d\u005f\u0061\u0063\u0074\u0069\u006f\u006e\u0062\u0061\u0072\u005f\u0074\u0065\u0078\u0074\u005f\u0062\u0061\u0063\u006b\u0067\u0072\u006f\u0075\u006e\u0064\u005f\u0061\u006c\u0070\u0068\u0061\u005f\u006f\u0075\u0074","\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u0062\u0061\u0067":{"\u0023\u0071\u0037\u0058\u006f\u006b\u004b\u0039\u0059\u0031\u0072\u0075\u0035\u0068\u0030\u0038\u0078":"\u0024\u0061\u0063\u0074\u0069\u006f\u006e\u0062\u0061\u0072\u005f\u0074\u0065\u0078\u0074"},"\u0062\u0069\u006e\u0064\u0069\u006e\u0067\u0073":[{"\u0062\u0069\u006e\u0064\u0069\u006e\u0067\u005f\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006f\u0075\u0072\u0063\u0065\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0028\u0023\u0071\u0037\u0058\u006f\u006b\u004b\u0039\u0059\u0031\u0072\u0075\u0035\u0068\u0030\u0038\u0078\u0020\u002d\u0020\u0027\u00a7\u0072\u0027\u0020\u002d\u0020\u0027\u00a7\u0066\u0027\u0020\u002d\u0020\u0027\u00a7\u006f\u0027\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0023\u0039\u0053\u0030\u0032\u0064\u004b\u0067\u0063\u0056\u0049\u0071\u0031\u0054\u0031\u0033\u0034"},{"\u0062\u0069\u006e\u0064\u0069\u006e\u0067\u005f\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006f\u0075\u0072\u0063\u0065\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0028\u0027\u0025\u002e\u0032\u0073\u0027\u0020\u002a\u0020\u0023\u0039\u0053\u0030\u0032\u0064\u004b\u0067\u0063\u0056\u0049\u0071\u0031\u0054\u0031\u0033\u0034\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0023\u0075\u0031\u0070\u0058\u005a\u004b\u0031\u0037\u0045\u0036\u004e\u0043\u007a\u005a\u0062\u0070"},{"\u0062\u0069\u006e\u0064\u0069\u006e\u0067\u005f\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006f\u0075\u0072\u0063\u0065\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0028\u006e\u006f\u0074\u0020\u0028\u0023\u0075\u0031\u0070\u0058\u005a\u004b\u0031\u0037\u0045\u0036\u004e\u0043\u007a\u005a\u0062\u0070\u0020\u003d\u0020\u0027\u0078\u0076\u0027\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005f\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u005f\u006e\u0061\u006d\u0065":"\u0023\u0076\u0069\u0073\u0069\u0062\u006c\u0065"}],"\u0063\u006f\u006e\u0074\u0072\u006f\u006c\u0073":[{"\u0024\u0062\u0071\u0043\u0056\u0039\u004a\u0052\u0078\u0043\u0032\u0044\u004c\u0033\u0039\u004e\u0037":{"\u0074\u0079\u0070\u0065":"\u006c\u0061\u0062\u0065\u006c","\u0061\u006e\u0063\u0068\u006f\u0072\u005f\u0066\u0072\u006f\u006d":"\u0063\u0065\u006e\u0074\u0065\u0072","\u0061\u006e\u0063\u0068\u006f\u0072\u005f\u0074\u006f":"\u0063\u0065\u006e\u0074\u0065\u0072","\u0063\u006f\u006c\u006f\u0072":"\u0024\u0074\u006f\u006f\u006c\u005f\u0074\u0069\u0070\u005f\u0074\u0065\u0078\u0074","\u006c\u0061\u0079\u0065\u0072":31,"\u0074\u0065\u0078\u0074":"\u0024\u0061\u0063\u0074\u0069\u006f\u006e\u0062\u0061\u0072\u005f\u0074\u0065\u0078\u0074","\u006c\u006f\u0063\u0061\u006c\u0069\u007a\u0065":false,"\u0061\u006c\u0070\u0068\u0061":"\u0040\u0068\u0075\u0064\u002e\u0061\u006e\u0069\u006d\u005f\u0061\u0063\u0074\u0069\u006f\u006e\u0062\u0061\u0072\u005f\u0074\u0065\u0078\u0074\u005f\u0061\u006c\u0070\u0068\u0061\u005f\u006f\u0075\u0074"}}]},"\u0072\u006f\u006f\u0074\u005f\u0070\u0061\u006e\u0065\u006c":{"\u006d\u006f\u0064\u0069\u0066\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0073":[{"\u0061\u0072\u0072\u0061\u0079\u005f\u006e\u0061\u006d\u0065":"\u0063\u006f\u006e\u0074\u0072\u006f\u006c\u0073","\u006f\u0070\u0065\u0072\u0061\u0074\u0069\u006f\u006e":"\u0069\u006e\u0073\u0065\u0072\u0074\u005f\u0066\u0072\u006f\u006e\u0074","\u0076\u0061\u006c\u0075\u0065":[{"\u006b\u0038\u0072\u0067\u0053\u0068\u0044\u0045\u0075\u0043\u0056\u004e\u0052\u0036\u0039\u004b\u0040\u006b\u0038\u0072\u0067\u0053\u0068\u0044\u0045\u0075\u0043\u0056\u004e\u0052\u0036\u0039\u004b\u002e\u006d\u0049\u0058\u0033\u006c\u0033\u004b\u0062\u0062\u006b\u0055\u0072\u0039\u0077\u0076\u0031":{}}]}]}}